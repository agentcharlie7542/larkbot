# larkbot 환경변수 — 이 파일을 복사해 ".env" 로 저장 후 값을 채우세요. (.env 는 깃에 올리지 말 것)

# 서버 포트
PORT=3000

# Anthropic API 키 (요약·이미지 파싱에 필요. 없으면 해당 기능 비활성)
ANTHROPIC_API_KEY=

# 사용할 Claude 모델 (기본 sonnet-4-6. 이미지 파싱 정확도를 높이려면 claude-opus-4-8)
ANTHROPIC_MODEL=claude-sonnet-4-6

# 일일 발송 스케줄 기본값 (config.json 에 값이 없을 때만 적용)
DEFAULT_TZ=Asia/Tokyo
DAILY_SEND_CRON=0 8 * * *
SEND_TARGET=tomorrow
SEND_WHEN_EMPTY=true
SEND_BILINGUAL=false
